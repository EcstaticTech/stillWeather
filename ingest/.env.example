# Cloudflare R2 S3-Compatible API Credentials (for uploading status.json)
R2_ACCOUNT_ID=<YOUR_R2_ACCOUNT_ID>
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<YOUR_R2_ACCESS_KEY_ID>
R2_SECRET_ACCESS_KEY=<YOUR_R2_SECRET_ACCESS_KEY>
R2_BUCKET_NAME=stillweather
R2_OBJECT_KEY=status.json

# Optional Dead-Man-Switch Ping (Healthchecks.io or Uptime Kuma push URL)
HEALTHCHECKS_PING_URL=https://hc-ping.com/<YOUR_UUID>

# Optional Runtime Overrides
SITES_CONFIG_PATH=/opt/stillweather/sites.json
SQLITE_DB_PATH=/var/lib/stillweather/stillweather_cache.db
STATUS_JSON_PATH=/var/lib/stillweather/status.json
GLM_POLL_INTERVAL_SECONDS=45
IEM_POLL_INTERVAL_SECONDS=90
