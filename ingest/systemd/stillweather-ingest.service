[Unit]
Description=stillWeather GOES-19 GLM & IEM NEXRAD Lightning Ingest Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stillweather
Group=stillweather
WorkingDirectory=/opt/stillweather
EnvironmentFile=/opt/stillweather/ingest/.env
ExecStart=/opt/stillweather/.venv/bin/python -m ingest.daemon
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/stillweather

[Install]
WantedBy=multi-user.target
